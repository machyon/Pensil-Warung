# Copy to .env for local development. Never commit real values.

# HTTP port (Render sets this itself)
PORT=3000
# development | production. Production refuses to start without a valid JWT_SECRET.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (Aiven: add ?sslmode=require)
DATABASE_URL=postgres://user:password@localhost:5432/pensil_warung
# CA certificate PEM contents (Aiven ca.pem) for TLS verification. Optional.
DATABASE_CA_CERT=
# Path to a CA file, relative to backend/. Used when DATABASE_CA_CERT is empty.
# If both are empty, the system root certificates are used. Non-local hosts only.
DATABASE_CA_CERT_FILE=ca.pem
DATABASE_POOL_MAX=5

# JWT signing key, at least 32 characters. REQUIRED in production.
# In development a random secret is generated when unset (tokens then die on restart).
JWT_SECRET=
# Access token lifetime: a number and a unit (s, m, h, d), for example 7d or 12h.
# There is no refresh token: the client logs in again after this.
JWT_EXPIRES_IN=7d

# Google OAuth client ids, comma separated (Android, iOS and web). ID tokens must
# have an aud that is in this list. Optional until Google sign-in is used.
GOOGLE_CLIENT_IDS=

# Tigris (S3-compatible) image storage. Optional until image upload is used.
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET=pensil-warung
# Bucket is private; clients get presigned GET URLs valid this many seconds
IMAGE_URL_TTL_SECONDS=3600

# Postgres 18 for the integration tests. The test harness creates and drops
# pw_test_<uuid> databases on this server, so the role needs CREATEDB.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
