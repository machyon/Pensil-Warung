# Copy to .env for local development. Never commit real values.

# HTTP port (Render sets this itself)
PORT=3000
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (Aiven: add ?sslmode=require)
DATABASE_URL=postgres://user:password@localhost:5432/pensil_warung
# CA certificate PEM contents (Aiven ca.pem) for TLS verification. Optional.
DATABASE_CA_CERT=
# Alternative: path to a CA file (relative to backend/). Used when DATABASE_CA_CERT is unset
# and the database is not local. Default: ca.pem if that file exists.
DATABASE_CA_CERT_FILE=ca.pem
DATABASE_POOL_MAX=5

# JWT signing key. REQUIRED in production (>= 32 chars). In development an ephemeral
# random secret is generated when unset.
JWT_SECRET=
# Access token lifetime (max 1h per spec)
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_DAYS=30

# Google OAuth Web Client ID (optional until /auth/google is used)
GOOGLE_CLIENT_ID=

# Tigris (S3-compatible) image storage. Optional until image upload is used.
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET=pensil-warung
# Bucket is private; clients get presigned GET URLs valid this many seconds
IMAGE_URL_TTL_SECONDS=3600
